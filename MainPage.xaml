<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CalculateurAge.Models"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:Class="CalculateurAge.MainPage"
             x:DataType="vm:CalculateurViewModel"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>
            <Label Text="La date de naissance ne peut pas être dans le futur."
                   TextColor="Red"
                   IsVisible="{Binding DateInvalide}"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Calculer"
                        Command="{Binding CalculerCommand}"/>
                <Button Text="Effacer"
                        Command="{Binding EffacerCommand}"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Statut}" FontSize="16"
                       FontAttributes="Bold"/>
                <Label Text="{Binding ProchainAnniversaire}" FontSize="16"/>
                <Button Text="Voir le détail"
                        Command="{Binding VoirDetailCommand}"/>
            </VerticalStackLayout>

            <Label Text="Historique" FontSize="18" FontAttributes="Bold"
                   Margin="0,20,0,0"/>
            <!-- BindableLayout plutôt que CollectionView : pas de liste défilante dans un ScrollView -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historique}"
                                 BindableLayout.EmptyView="Aucun calcul pour l'instant.">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Calcul">
                        <VerticalStackLayout Padding="0,6">
                            <Label Text="{Binding Resume}" FontSize="15"/>
                            <Label Text="{Binding Horodatage, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Vider l'historique"
                    Command="{Binding ViderHistoriqueCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
