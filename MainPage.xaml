<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:Class="CalculateurAge.MainPage"
             x:DataType="vm:CalculateurViewModel"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>
            <Label Text="La date de naissance ne peut pas être dans le futur."
                   TextColor="Red"
                   IsVisible="{Binding DateInvalide}"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Calculer"
                        Command="{Binding CalculerCommand}"/>
                <Button Text="Effacer"
                        Command="{Binding EffacerCommand}"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Statut}" FontSize="16"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
